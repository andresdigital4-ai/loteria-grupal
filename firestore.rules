rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomExists(code) {
      return exists(/databases/$(database)/documents/rooms/$(code));
    }
    function isHost(code) {
      return signedIn() && roomExists(code) &&
        get(/databases/$(database)/documents/rooms/$(code)).data.hostUid == request.auth.uid;
    }
    function isCaller(code) {
      return signedIn() && roomExists(code) &&
        get(/databases/$(database)/documents/rooms/$(code)).data.callerUid == request.auth.uid;
    }

    match /rooms/{code} {
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == "waiting"
        && request.resource.data.drawn is list
        && request.resource.data.drawn.size() == 0;
      allow read: if signedIn();
      allow update: if signedIn() && (
        isHost(code) ||
        (isCaller(code)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["drawn","lastNumber"])
          && request.resource.data.drawn.size() == resource.data.drawn.size() + 1
          && request.resource.data.drawn.hasAll(resource.data.drawn)
          && request.resource.data.drawn.hasAny([request.resource.data.lastNumber])
          && !resource.data.drawn.hasAny([request.resource.data.lastNumber])
          && request.resource.data.lastNumber is int
          && request.resource.data.lastNumber >= 1
          && request.resource.data.lastNumber <= 90)
      );
      allow delete: if isHost(code);

      match /players/{playerId} {
        allow read: if signedIn();
        allow create: if signedIn() && playerId == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow update: if signedIn() && playerId == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isHost(code);
      }
    }
  }
}